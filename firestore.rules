rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Docs written before per-user scoping have no `userId` field at
    // all — see the comment on fetchWorkoutPlans. Requiring it outright
    // would make them permanently unreadable.
    //
    // KNOWN RISK: for a LIST query Firestore checks the query's own
    // constraints rather than reading the documents first. A plain
    // `resource.data.userId == request.auth.uid` pairs provably with the
    // `where('userId', '==', uid)` filter every service uses; whether
    // the `in` disjunction below is accepted the same way is not
    // something the docs commit to. If list reads ever fail with
    // "Missing or insufficient permissions" while single-document reads
    // work, drop the first branch — the `where` clause already filters
    // fieldless docs out, so nothing visible is lost.
    function ownsExisting() {
      return isSignedIn() &&
             // A `get` on a document that does not exist still evaluates
             // these rules, but with `resource` set to null — and
             // reading `resource.data` off null fails evaluation, which
             // surfaces as "Missing or insufficient permissions" rather
             // than an empty result. Every getDoc() in the app can hit
             // this: fetchTelemetry, fetchMealLog, fetchWorkoutLog
             // and savePlannedOccurrence all read a document that may
             // not have been written yet. There is nothing to leak in a
             // document that does not exist, so allow it.
             (resource == null ||
              !('userId' in resource.data) ||
              resource.data.userId == request.auth.uid);
    }

    function keepsOwnership() {
      return !('userId' in request.resource.data) ||
             request.resource.data.userId == request.auth.uid;
    }

    match /workoutPlans/{planId} {
      allow read:   if ownsExisting();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsExisting() && keepsOwnership();
      allow delete: if ownsExisting();
    }

    match /workoutLogs/{logId} {
      allow read:   if ownsExisting();

      // The doc id is `${uid}_${planId}_${date}`. Pinning it to the
      // caller's uid stops anyone squatting on another user's log id —
      // which would permanently block that user from saving that day,
      // since their own write would then fail ownsExisting().
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       logId == request.auth.uid + '_' +
                                request.resource.data.planId + '_' +
                                request.resource.data.date;

      allow update: if ownsExisting() && keepsOwnership();
      allow delete: if false;
    }

    // Same contract as workoutLogs: one doc per (user, plan, date),
    // with the id pinned to the caller's uid.
    match /mealLogs/{logId} {
      allow read: if ownsExisting();

      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       logId == request.auth.uid + '_' +
                                request.resource.data.planId + '_' +
                                request.resource.data.date;

      allow update: if ownsExisting() && keepsOwnership();
      allow delete: if false;
    }

    // One doc per (user, date), holding that day's dashboard metrics:
    // water, steps, calories burned, sleep and body weight. Not tied to
    // a plan, so the id has no plan segment.
    //
    // Deliberately the simplest rule in this file. It does NOT pin the
    // document id the way the two log collections do: that pin is
    // defence-in-depth, not correctness. The ownership checks below are
    // what actually protect the data.
    //
    // `resource == null` covers a read or a first write of a document
    // that does not exist yet — which is every new day, since the
    // dashboard reads before anything has been recorded.
    match /telemetry/{dayId} {
      allow read: if isSignedIn() &&
                     (resource == null ||
                      resource.data.userId == request.auth.uid);

      allow write: if isSignedIn() &&
                      (resource == null ||
                       resource.data.userId == request.auth.uid) &&
                      request.resource.data.userId == request.auth.uid;
    }

    // SUPERSEDED by /telemetry, which now holds water alongside the rest
    // of the day. Kept readable so a user's existing water history can be
    // carried forward the first time they open one of those days — see
    // readLegacyWater in telemetryService.
    //
    // Writes are off: nothing in the app writes here any more, and a
    // write would strand data in a collection that is on its way out.
    //
    // SAFE TO DELETE, together with readLegacyWater and the collection
    // itself, once no user has unmigrated days worth keeping.
    match /hydrationLogs/{logId} {
      allow read: if isSignedIn() &&
                     (resource == null ||
                      resource.data.userId == request.auth.uid);

      allow write: if false;
    }

    // Onboarding profile — the document id IS the uid (see
    // userProfileService), so ownership is checked against the id
    // rather than a field. That also covers the read of a document
    // that does not exist yet, which every first registration performs
    // before writing anything.
    match /userProfiles/{profileId} {
      allow read: if isSignedIn() && profileId == request.auth.uid;

      allow write: if isSignedIn() &&
                      profileId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid;
    }

    // Feature flags — one document per flag, id = flag key, body
    // { enabled: boolean }. See docs/feature-flags.md.
    //
    // Read is deliberately public: flags must resolve before sign-in
    // (splash, login and onboarding all render without a session, and a
    // kill switch that cannot disable the login path is not a kill
    // switch). That is safe only because these documents hold no secret
    // and no user data — flag keys name features whose code already
    // ships in the app. Never put anything here that is not public.
    //
    // Write is limited to one hardcoded admin uid. Toggling is done by
    // hand in the Firebase console (which bypasses rules anyway); this
    // rule exists so that no client, signed in or not, can flip a flag.
    //
    // TODO(before deploy): replace YOUR_UID_HERE with the real admin uid
    // (Firebase console > Authentication > Users > User UID). Until then
    // the placeholder matches no real user, so nobody can write. These
    // rules are NOT deployed by this repo's tasks.
    match /featureToggle/{flagKey} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == 'YOUR_UID_HERE';
    }

    match /mealPlans/{planId} {
      allow read:   if ownsExisting();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsExisting() && keepsOwnership();
      allow delete: if ownsExisting();
    }
  }
}
