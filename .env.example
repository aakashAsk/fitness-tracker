# Copy this file to `.env` (Expo loads `.env` automatically — no extra
# package needed on SDK 49+) and fill in real values.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time
# and are readable by anyone who has the app, so never put secrets here.
EXPO_PUBLIC_EXERCISE_API_BASE_URL=https://exercise-db-pi.vercel.app

# Firebase project config — from Firebase Console > Project settings >
# General > "Your apps" > SDK setup and configuration > Config.
# Safe to expose to the client (that's what these are for); access is
# controlled by Firestore Security Rules, not by keeping this secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional — unused today (Firebase Analytics is web-only, not RN).
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Gemini — https://aistudio.google.com/apikey
#
# WARNING: unlike the Firebase config above, this is a BILLING
# credential. EXPO_PUBLIC_ inlines it into the bundle, so anyone with
# the APK can extract it and spend your quota. Use it for local
# development only; before release put a Cloud Function in front and
# point EXPO_PUBLIC_GEMINI_PROXY_URL at it instead.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
# Optional — defaults to gemini-3.6-flash.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# Optional — set this (and clear the key above) once a proxy exists.
EXPO_PUBLIC_GEMINI_PROXY_URL=

# Cloudinary — profile picture uploads.
# Unsigned uploads only: create an *unsigned* upload preset in the
# Cloudinary console (Settings > Upload > Upload presets) and put its
# name below. Never put the API secret in this file — everything
# EXPO_PUBLIC_* ships inside the app bundle.
#
# The preset must be configured to replace a user's previous picture
# rather than pile up copies of it. In the preset, set:
#   Signing mode:     Unsigned
#   Folder:           avatars
#   Unique filename:  OFF   (else Cloudinary appends random suffixes
#                            and the public_id we send is ignored)
#   Overwrite:        ON    (cannot be sent per-request when unsigned)
#   Invalidate:       ON    (purges the CDN copy of the old image)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dbtn8cgqq
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=pulsefit_avatars
