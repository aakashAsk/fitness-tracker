# Copy this file to `.env` (Expo loads `.env` automatically — no extra
# package needed on SDK 49+) and fill in real values.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time
# and are readable by anyone who has the app, so never put secrets here.
EXPO_PUBLIC_EXERCISE_API_BASE_URL=https://exercise-db-pi.vercel.app

# Firebase project config — from Firebase Console > Project settings >
# General > "Your apps" > SDK setup and configuration > Config.
# Safe to expose to the client (that's what these are for); access is
# controlled by Firestore Security Rules, not by keeping this secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional — unused today (Firebase Analytics is web-only, not RN).
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=


# Cloudinary — profile picture uploads.
# Unsigned uploads only: create an *unsigned* upload preset in the
# Cloudinary console (Settings > Upload > Upload presets) and put its
# name below. Never put the API secret in this file — everything
# EXPO_PUBLIC_* ships inside the app bundle.
#
# The preset must be configured to replace a user's previous picture
# rather than pile up copies of it. In the preset, set:
#   Signing mode:     Unsigned
#   Folder:           avatars
#   Unique filename:  OFF   (else Cloudinary appends random suffixes
#                            and the public_id we send is ignored)
#   Overwrite:        ON    (cannot be sent per-request when unsigned)
#   Invalidate:       ON    (purges the CDN copy of the old image)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dbtn8cgqq
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=pulsefit_avatars


# OpenRouter — powers the per-item nutrition estimates (macros + fibre,
# sugar, sodium) written onto a meal after it saves.
#
# SECURITY: everything EXPO_PUBLIC_* is inlined into the app bundle, so
# this key ships inside the APK and anyone can extract it. Unlike the
# Firebase config above, it is a BILLING credential with no server-side
# guard. Treat direct calls as development-only:
#   - set a hard spend limit: https://openrouter.ai/settings/keys
#   - before any public build, put a proxy in front (a Cloud Function
#     that holds the key) and set EXPO_PUBLIC_OPENROUTER_PROXY_URL.
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Optional — the model doing the estimates. Defaults to
# openai/gpt-4o-mini when unset or blank.
#
# nex-agi/nex-n2.5-mini:free costs nothing and tested more accurately,
# but is capped at 50 requests/day and requires Zero Data Retention to
# be OFF — meaning the provider may train on the prompt, which contains
# the user's food entries. Fine for development; think before shipping.
#
# Whatever you pick must support structured outputs. Reasoning models
# are handled: the service sends reasoning.enabled=false, without which
# they spend the whole token budget thinking and return nothing.
EXPO_PUBLIC_OPENROUTER_MODEL=

# Set once a server-side proxy exists; the key then never ships.
EXPO_PUBLIC_OPENROUTER_PROXY_URL=

# Local Firebase emulator (opt-in, development only). Leave unset to use
# the real project. Start it with `firebase emulators:start`.
# Android emulator: EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2 (127.0.0.1 there is
# the VM itself). Physical device on Wi-Fi: your computer's LAN address.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
EXPO_PUBLIC_EMULATOR_HOST=
