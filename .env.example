# Copy this file to `.env` (Expo loads `.env` automatically — no extra
# package needed on SDK 49+) and fill in real values.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time
# and are readable by anyone who has the app, so never put secrets here.
EXPO_PUBLIC_EXERCISE_API_BASE_URL=https://exercise-db-pi.vercel.app

# Firebase project config — from Firebase Console > Project settings >
# General > "Your apps" > SDK setup and configuration > Config.
# Safe to expose to the client (that's what these are for); access is
# controlled by Firestore Security Rules, not by keeping this secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional — unused today (Firebase Analytics is web-only, not RN).
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
